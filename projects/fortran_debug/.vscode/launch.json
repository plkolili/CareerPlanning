{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Fortran: 调试单文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Fortran: 构建单文件",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Fortran: 调试多文件项目",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/math_demo",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Fortran: 构建多文件项目",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
